# Copy to api/.env and fill in real values. NEVER commit the real .env file.
# Production secrets must be real, randomly generated values injected via
# environment variables or a secret manager. The server refuses to start if
# JWT_SECRET or INTERNAL_API_SECRET is missing, too short, or a placeholder.
#
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Supabase Database Connection
# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations (npx prisma db push / prisma migrate dev).
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Auth (REQUIRED) - at least 32 random characters. Rotating it logs everyone out.
JWT_SECRET=<strong-random-production-secret>

# Access token lifetime (optional, default 1h). Format: 15m, 1h, 12h, 7d.
JWT_EXPIRES_IN=1h

# Max /api/auth/* requests per minute per IP (optional, default 10).
AUTH_RATE_LIMIT_PER_MIN=10

# Comma-separated list of extra origins allowed to call the API cross-origin
# (optional). Leave empty when the frontend is served by this same server.
CORS_ORIGINS=

# Server
PORT=3000

# Inter-Service Communication (REQUIRED) - shared secret sent to the Mock Portal
# in the x-internal-api-secret header. At least 16 random characters, and it must
# match the value configured on the Mock Portal.
INTERNAL_API_SECRET=<strong-random-shared-secret>

# Tests only (optional): a SEPARATE, disposable database. The DB-backed test suites
# delete all rows, so this must never point at production. When unset, those suites
# are skipped.
# TEST_DATABASE_URL=
